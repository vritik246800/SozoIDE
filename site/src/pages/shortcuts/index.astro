---
// Every key SozoIDE comes with, read at build from the table of the README, which Help keeps in
// step with (TODO 6.4.4). F1 inside SozoIDE shows the keys of your system and the ones you changed.
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Page from '../../layouts/Page.astro';

const readme = readFileSync(resolve(process.cwd(), '../README.md'), 'utf8');
const table = readme.slice(readme.indexOf('| Key | Action |'));
const rows = table
  .split('\n')
  .slice(2)
  .filter((line) => line.startsWith('|'))
  .map((line) => line.slice(1, -1).split(/(?<!\\)\|/).map((cell) => cell.trim().replace(/\\\|/g, '|').replace(/`/g, '')));
if (rows.length < 20) throw new Error('The keys table of the README was not found');
---

<Page title="Keys" description="Every key and mouse gesture of SozoIDE.">
  <p>F1 inside SozoIDE shows the keys of your own system, with the ones you changed.</p>
  <table>
    <thead><tr><th scope="col">Key</th><th scope="col">Action</th></tr></thead>
    <tbody>{rows.map(([key, action]) => <tr><td><kbd>{key}</kbd></td><td>{action}</td></tr>)}</tbody>
  </table>
</Page>
