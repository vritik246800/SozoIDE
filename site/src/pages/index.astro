---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import '@fontsource-variable/martian-mono/wdth.css';
import Screen from '../components/Screen.astro';
import screens from '../data/screens.json';

// The ASCII art, the author and the version come from the app itself, so the site never drifts
// from it: a new release shows its version on the splash of the hero.
const branding = readFileSync(resolve(process.cwd(), '../src/branding.rs'), 'utf8');
// Only the flower of the splash: branding.rs also keeps a larger one for the About dialog.
const art = branding.match(/pub const ASCII_LOGO: &\[&str\] = &\[\n([\s\S]*?)\n\];/)?.[1] ?? '';
const logo = [...art.matchAll(/^\s*r"(.*)",$/gm)].map((match) => match[1]).join('\n');
const author = branding.match(/AUTHOR: &str = "(.*)";/)?.[1];
const version = readFileSync(resolve(process.cwd(), '../Cargo.toml'), 'utf8').match(/^version = "(.*)"$/m)?.[1];
if (!logo || !author || !version) throw new Error('Could not read the branding from src/branding.rs and Cargo.toml');

// The splash of the TUI (src/ui/overlays.rs): every line centered in the 132x34 screen of the
// captures, the loading bar in the middle (the script draws its sweep).
const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const center = (text: string) => ' '.repeat(Math.floor((screens.cols - [...text].length) / 2)) + escape(text);
const barWidth = 30;
const splashLines = [
  ...logo.split('\n').map((line) => `<span class="f6">${center(line)}</span>`),
  '',
  `<span class="b">${center('SozoIDE')}</span>`,
  center(`Version ${version}`),
  '',
  `${' '.repeat(Math.floor((screens.cols - barWidth) / 2))}<span data-bar="${barWidth}">${'<span class="f8">─</span>'.repeat(barWidth)}</span>`,
  `<span class="f8">${center('Starting...')}</span>`,
  `<span class="f8">${center('Press any key to continue')}</span>`,
];
const splashTop = Math.floor((screens.rows - splashLines.length) / 2);
// The splash clears the whole screen; its lines are printed one by one (src/scripts/motion.ts).
const splash = Array.from({ length: screens.rows }, (_, row) => {
  const line = splashLines[row - splashTop];
  return line === undefined ? '' : `<span class="line">${line}</span>`;
}).join('\n');

// The keys of the demo in the hero (src/scripts/demo.ts).
const demoKeys = [
  { key: 'git', keys: ['Ctrl', 'G'], label: 'Source Control', toggle: true },
  { key: 'database', keys: ['Ctrl', 'D'], label: 'Database', toggle: true },
  { key: 'search', keys: ['Ctrl', 'P'], label: 'Search', toggle: true },
  { key: 'help', keys: ['F1'], label: 'Help', toggle: true },
  { key: 'tab', keys: ['Tab'], label: 'Next tab', toggle: false },
  { key: 'escape', keys: ['Esc'], label: 'Back', toggle: false },
];
const panels = ['git-changes', 'git-graph', 'db-query', 'db-results'] as const;

const repo = 'https://github.com/vritik246800/SozoIDE';
const latest = `${repo}/releases/latest`;
// Package names carry no version, so these always download the file of the latest release
// (CLAUDE.md §10). The same names are what the app's updater downloads.
const download = (file: string) => `${repo}/releases/latest/download/SozoIDE-${file}`;
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base.replace(/\/$/, '')}/${path}`;

// Real terminal themes: background, foreground and ANSI 0-15 (Docs/development/DESIGN.md §2.2).
const themes = [
  { id: 'campbell', name: 'Campbell', from: 'Windows Terminal', bg: '#0C0C0C', fg: '#CCCCCC',
    ansi: ['#0C0C0C', '#C50F1F', '#13A10E', '#C19C00', '#0037DA', '#881798', '#3A96DD', '#CCCCCC',
      '#767676', '#E74856', '#16C60C', '#F9F1A5', '#3B78FF', '#B4009E', '#61D6D6', '#F2F2F2'] },
  { id: 'iterm2', name: 'iTerm2', from: 'macOS', bg: '#000000', fg: '#C7C7C7',
    ansi: ['#000000', '#C91B00', '#00C200', '#C7C400', '#0225C7', '#CA30C7', '#00C5C7', '#C7C7C7',
      '#686868', '#FF6E67', '#5FFA68', '#FFFC67', '#6871FF', '#FF77FF', '#60FDFF', '#FFFFFF'] },
  { id: 'ubuntu', name: 'Ubuntu', from: 'GNOME Terminal', bg: '#300A24', fg: '#FFFFFF',
    ansi: ['#2E3436', '#CC0000', '#4E9A06', '#C4A000', '#3465A4', '#75507B', '#06989A', '#D3D7CF',
      '#555753', '#EF2929', '#8AE234', '#FCE94F', '#729FCF', '#AD7FA8', '#34E2E2', '#EEEEEC'] },
  { id: 'gruvbox', name: 'Gruvbox', from: 'Dark', bg: '#282828', fg: '#EBDBB2',
    ansi: ['#282828', '#CC241D', '#98971A', '#D79921', '#458588', '#B16286', '#689D6A', '#A89984',
      '#928374', '#FB4934', '#B8BB26', '#FABD2F', '#83A598', '#D3869B', '#8EC07C', '#EBDBB2'] },
  { id: 'dracula', name: 'Dracula', from: 'Dark', bg: '#282A36', fg: '#F8F8F2',
    ansi: ['#21222C', '#FF5555', '#50FA7B', '#F1FA8C', '#BD93F9', '#FF79C6', '#8BE9FD', '#F8F8F2',
      '#6272A4', '#FF6E6E', '#69FF94', '#FFFFA5', '#D6ACFF', '#FF92DF', '#A4FFFF', '#FFFFFF'] },
];
const themeCss = [
  ...themes.map(({ id, bg, fg, ansi }, index) => {
    const selector = index === 0 ? `:root, :root[data-theme="${id}"]` : `:root[data-theme="${id}"]`;
    return `${selector} { --bg: ${bg}; --fg: ${fg}; ${ansi.map((color, slot) => `--c${slot}: ${color};`).join(' ')} }`;
  }),
  ...themes[0].ansi.map((_, slot) => `.f${slot} { --cell: var(--c${slot}); color: var(--cell); }`),
].join('\n');

const features = [
  { keys: [['Ctrl', 'B']], title: 'Explorer and editor',
    text: 'Browse the project tree, with an icon for every file type, and open files in tabs that scroll when there are many; drag a tab to an edge of the editor to split it side by side or stacked, each side with its own tabs. Long lines scroll sideways. Select text with the mouse or Shift and the arrows, and copy it with Ctrl+C. Edits save themselves after two idle seconds and before you switch tabs or quit. Syntax highlighting covers more than 30 languages, from Rust and Go to SQL, JSP, Astro and Mermaid, and configuration files by their name, from .env and Cargo.lock to Dockerfile, with its own colour for keywords, types, functions, strings and numbers, down to the last line of long files. Markdown is drawn as you read it: headings in their own size and colour, quotes, rules, framed code blocks, Mermaid diagrams in box-drawing characters (C4, ZenUML, Kanban, Radar and Treemap too) and tables with inline formatting, with the source back under the cursor or the mouse. Images render inline on Sixel, Kitty and iTerm2 terminals, and PDF files open in a tab, one page at a time.' },
  { keys: [['Ctrl', 'J'], ['Ctrl', 'Shift', 'B']], title: 'Two terminals',
    text: 'A bottom and a right terminal, each with its own shell. The right terminal opens with Ctrl+Shift+B on Windows, Ctrl+Option+B on macOS and Ctrl+Alt+B on Linux. Scroll back with the mouse wheel or Page Up and Page Down, and drag the dividers to resize every panel.' },
  { keys: [['Ctrl', 'G']], title: 'Source Control',
    text: 'Stage and commit, follow the commit graph, and see every branch in a tree grouped by remote and folder: click one to switch to it. The Launchpad shows your branch, its upstream, how far ahead and behind it is and the files waiting to be committed. The diff numbers its lines, folds its hunks, goes side by side and moves to the next changed file. Pull is fast-forward only, and rebase or checkout ask before they run.' },
  { keys: [['Ctrl', 'D']], title: 'Database',
    text: 'Connect to SQLite, PostgreSQL and MySQL, write a query and run it with Ctrl+Enter or F5. Results show the rows, the affected count and the duration, and keep a history. Saved connections never write passwords to disk.' },
  { keys: [['Ctrl', 'P'], ['Ctrl', 'Shift', 'P']], title: 'Search',
    text: 'Find text in the open file or across the whole folder. Files listed in .gitignore stay out of the results.' },
  { keys: [['F1'], ['F2']], title: 'Help and About',
    text: 'Every command in boxed sections, in the colours of your terminal and with the keys your system types (fn+F1 on a Mac). A short tutorial on the first start, notes on what is new in every version since yours after an update, and in About the flower grows in the middle and a button opens the repository to contribute.' },
];

// The title rises word by word (Docs/development/DESIGN.md §2.5); the last three words take the accent.
const title = 'Code, shells, Git and SQL in one terminal window.'
  .split(' ')
  .map((text, index, words) => ({ text, accent: index >= words.length - 3 }));
---

<html lang="en" data-theme="campbell">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SozoIDE: an IDE in your terminal</title>
    <meta name="description" content="SozoIDE puts an editor, two terminals, Git and a SQL client in one terminal window. Free and open source for Windows, macOS and Linux." />
    <meta property="og:title" content="SozoIDE: an IDE in your terminal" />
    <meta property="og:description" content="An editor, two terminals, Git and a SQL client in one terminal window." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(base, Astro.site)} />
    <link rel="icon" type="image/png" href={asset('favicon.png')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <style is:inline set:html={themeCss}></style>
    <script is:inline>
      // Pick the theme before the first paint: the saved one, else the default terminal of this OS.
      (() => {
        const platform = navigator.userAgentData?.platform || navigator.platform || '';
        const os = /win/i.test(platform) ? 'windows'
          : /mac/i.test(platform) && navigator.maxTouchPoints < 2 ? 'macos'
          : /linux/i.test(platform) && !/android/i.test(navigator.userAgent) ? 'linux'
          : '';
        let saved = null;
        try { saved = localStorage.getItem('sozo-theme'); } catch {}
        const root = document.documentElement;
        root.dataset.os = os;
        root.dataset.theme = saved || { windows: 'campbell', macos: 'iterm2', linux: 'ubuntu' }[os] || 'campbell';
        // The moving parts wait hidden for the motion script; if it never runs, they show anyway.
        if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          root.dataset.motion = 'wait';
          setTimeout(() => {
            if (root.dataset.motion === 'wait') root.dataset.motion = 'off';
          }, 3000);
        }
      })();
    </script>
  </head>
  <body>
    <header class="top">
      <a class="brand" href={base}>SozoIDE</a>
      <nav aria-label="Main">
        <a href="#features">Features</a>
        <a href="#download">Download</a>
        <a href={repo}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="title">
        <h1 id="title" aria-label={title.map(({ text }) => text).join(' ')}>
          {title.map(({ text, accent }, index) => (
            <Fragment>{index > 0 && ' '}<span class:list={['word', { accent }]} aria-hidden="true">{text}</span></Fragment>
          ))}
        </h1>
        <p class="lede">
          SozoIDE is a terminal-native IDE written in Rust. Run <code>sozo .</code> in any folder to
          get an editor, two terminals, a Git browser and a SQL client side by side.
        </p>
        <div class="actions">
          <a class="button" href={latest} data-download={download('')}>
            Download<span class="for" data-for="macos"> for macOS</span><span class="for" data-for="windows"> for Windows</span><span class="for" data-for="linux"> for Linux</span>
          </a>
          <a class="quiet" href={repo}>Source on GitHub</a>
        </div>
        <p class="note">Free and open source under Apache-2.0, for Windows, macOS and Linux.</p>

        <div class="demo" data-demo>
          <figure class="window" tabindex="0" aria-label="SozoIDE in a terminal, from real captures. Focus it and press Ctrl+G, Ctrl+D, Ctrl+P, F1 or Esc, or use the keys below it.">
            <p class="boot" aria-hidden="true">orbit $ <span class="typed">sozo .</span><span class="cursor">█</span></p>
            <div class="stage">
              <Screen name="editor" runs={screens.screens.editor} />
              {panels.map((name) => <Screen name={name} runs={screens.screens[name]} hidden />)}
              <Screen name="splash" class="splash" html={splash} hidden />
              {Object.entries(screens.dialogs).map(([name, dialog]) => (
                <div class="dialog" data-screen={name} data-height={dialog.height} hidden aria-hidden="true" style={`--top:${dialog.top};--left:${dialog.left};--width:${dialog.width};--height:${dialog.height}`}>
                  <Screen class="edge-top" runs={dialog.rows.slice(0, 1)} />
                  <Screen class="body" runs={dialog.rows.slice(1, -1)} />
                  <Screen class="edge-bottom" runs={dialog.rows.slice(-1)} />
                </div>
              ))}
            </div>
            <figcaption class="visually-hidden" aria-live="polite" data-demo-status>SozoIDE showing the editor with src/lib.rs and cargo test in the bottom terminal.</figcaption>
          </figure>
          <div class="try" role="group" aria-label="Try the keys of SozoIDE">
            <span class="try-label">Try it</span>
            {demoKeys.map(({ key, keys, label, toggle }) => (
              <button type="button" data-demo-key={key} aria-pressed={toggle ? 'false' : undefined}>
                {keys.map((name) => <kbd>{name}</kbd>)}<span>{label}</span>
              </button>
            ))}
          </div>
        </div>

        <fieldset class="themes">
          <legend>SozoIDE has no colors of its own: it draws with the 16 colors of your terminal theme. Try another theme on this page.</legend>
          <div class="theme-list">
            {themes.map((theme, index) => (
              <button type="button" data-theme-option={theme.id} aria-pressed="false" style={`--i:${index}`}>
                <span class="swatch" aria-hidden="true">
                  {theme.ansi.map((color) => <i style={`background:${color}`}></i>)}
                </span>
                <span class="theme-name">{theme.name}</span>
                <span class="theme-from">{theme.from}</span>
              </button>
            ))}
          </div>
        </fieldset>
      </section>

      <section id="features" aria-labelledby="features-title">
        <h2 id="features-title" class="reveal" aria-label="One key for each tool">One key for each tool</h2>
        <dl class="keymap">
          {features.map((feature) => (
            <div class="key-row reveal">
              <dt>
                {feature.keys.map((combo, index) => (
                  <span class="combo">
                    {index > 0 && <span class="or">or</span>}
                    {combo.map((key) => <kbd>{key}</kbd>)}
                  </span>
                ))}
              </dt>
              <dd>
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="download" aria-labelledby="download-title">
        <h2 id="download-title" class="reveal" aria-label="Download">Download</h2>
        <p class="section-lede reveal">
          Installers for the latest release. Each one gives you the <code>sozo</code> command;
          then open a terminal in any project and run <code>sozo .</code>
        </p>
        <p class="section-lede reveal">
          On its first start, and once after each update, SozoIDE counts itself anonymously: GitHub's
          download counter learns the system, the architecture and the version, nothing else.
          Set <code>SOZO_NO_TELEMETRY=1</code> to turn it off.
        </p>
        <div class="platforms">
          <article class="platform reveal" data-platform="macos">
            <h3>macOS <span class="yours">This device</span></h3>
            <p class="file">SozoIDE-macos-arm64.dmg</p>
            <p>For Apple silicon Macs. Open it, drag SozoIDE to Applications and open the app: it offers to install the <code>sozo</code> command.</p>
            <p class="caveat">The app is not notarized yet. If macOS does not open it, go to System Settings, Privacy &amp; Security, and choose Open Anyway.</p>
            <a class="button" href={download('macos-arm64.dmg')}>Download the .dmg</a>
          </article>
          <article class="platform reveal" data-platform="windows">
            <h3>Windows <span class="yours">This device</span></h3>
            <p class="file">SozoIDE-windows-x86_64.msi or -arm64.msi</p>
            <p>A setup wizard that installs for your user only, without administrator rights, and adds <code>sozo</code> to your PATH.</p>
            <p class="caveat">The installer is not signed yet. If SmartScreen appears, choose More info, then Run anyway.</p>
            <p class="links">Also for ARM64 PCs: <a href={download('windows-arm64.msi')}>SozoIDE-windows-arm64.msi</a></p>
            <a class="button" href={download('windows-x86_64.msi')}>Download the .msi</a>
          </article>
          <article class="platform reveal" data-platform="linux">
            <h3>Linux <span class="yours">This device</span></h3>
            <p class="file">.deb, .rpm and .tar.gz for x86_64 and ARM64</p>
            <p>Open the .deb or .rpm in your software installer, or install it from a terminal. Either way you get <code>sozo</code> in <code>/usr/bin</code>.</p>
            <pre><code>sudo apt install ./SozoIDE-linux-*.deb
sudo dnf install ./SozoIDE-linux-*.rpm</code></pre>
            <p class="links">
              x86_64: <a href={download('linux-x86_64.deb')}>.deb</a> <a href={download('linux-x86_64.rpm')}>.rpm</a> <a href={download('linux-x86_64.tar.gz')}>.tar.gz</a><br />
              ARM64: <a href={download('linux-arm64.deb')}>.deb</a> <a href={download('linux-arm64.rpm')}>.rpm</a> <a href={download('linux-arm64.tar.gz')}>.tar.gz</a>
            </p>
            <a class="button" href={download('linux-x86_64.deb')}>Download the .deb</a>
          </article>
        </div>
        <p class="checksums reveal">Every release lists the SHA-256 of each file in <code>SHA256SUMS.txt</code>.</p>
      </section>

      <section id="source" aria-labelledby="source-title">
        <h2 id="source-title" class="reveal" aria-label="Build from source">Build from source</h2>
        <p class="section-lede reveal">You need Rust stable and Git.</p>
        <pre class="reveal"><code>git clone https://github.com/vritik246800/SozoIDE.git
cd SozoIDE
cargo build --release
./target/release/sozo .</code></pre>
      </section>
    </main>

    <footer class="bottom">
      <canvas class="stars" aria-hidden="true"></canvas>
      <pre class="logo draw" aria-hidden="true">{logo}</pre>
      <p>SozoIDE by {author}. Licensed under Apache-2.0. <a href={repo}>Source on GitHub</a></p>
    </footer>

    <canvas class="wave" aria-hidden="true" hidden></canvas>

    <script>
      import { starField } from '../scripts/ascii';
      import '../scripts/demo';
      import '../scripts/motion';
      import '../scripts/theme';

      const root = document.documentElement;

      // The main button downloads the package of this system; ARM is only visible to Chromium
      // (userAgentData) and to Linux browsers (navigator.platform). Unknown systems keep the
      // release page.
      const packages: Record<string, string> = {
        macos: 'macos-arm64.dmg',
        windows: 'windows-x86_64.msi',
        linux: 'linux-x86_64.deb',
      };
      const downloadButton = document.querySelector<HTMLAnchorElement>('[data-download]');
      const setPackage = (file: string) => {
        if (downloadButton) downloadButton.href = downloadButton.dataset.download + file;
      };
      const detected = packages[root.dataset.os ?? ''];
      if (detected) {
        const arm = (file: string) => file.replace('x86_64', 'arm64');
        setPackage(/aarch64|arm/i.test(navigator.platform) ? arm(detected) : detected);
        (navigator as Navigator & { userAgentData?: { getHighEntropyValues(hints: string[]): Promise<{ architecture?: string }> } })
          .userAgentData?.getHighEntropyValues(['architecture'])
          .then(({ architecture }) => { if (architecture === 'arm') setPackage(arm(detected)); })
          .catch(() => {});
      }

      const stars = document.querySelector<HTMLCanvasElement>('canvas.stars');
      if (stars) starField(stars);
    </script>

    <style is:global>
      :root {
        color-scheme: dark;
        --accent: var(--c6);
        --muted: var(--c7);
        --line: var(--c8);
        --display: 'Martian Mono Variable', ui-monospace, monospace;
        --mono: ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
        --ease: cubic-bezier(0.33, 1, 0.68, 1);
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        background: var(--bg);
        color: var(--fg);
      }

      body {
        margin: 0;
        font: 1.0625rem / 1.6 system-ui, sans-serif;
      }

      /* With View Transitions the theme change is a wave (script below); without, the colors fade. */
      @supports not (view-transition-name: none) {
        @media (prefers-reduced-motion: no-preference) {
          html,
          html * {
            transition:
              color 160ms var(--ease),
              background-color 160ms var(--ease),
              border-color 160ms var(--ease);
          }
        }
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }

      a {
        color: var(--accent);
        text-underline-offset: 0.2em;
      }

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      code,
      pre,
      kbd,
      var {
        font-family: var(--mono);
        font-style: normal;
      }

      code {
        font-size: 0.92em;
      }

      pre {
        margin: 0;
        overflow-x: auto;
        padding: 14px 16px;
        border: 1px solid var(--line);
        border-radius: 6px;
        font-size: 0.9rem;
        line-height: 1.5;
      }

      h1,
      h2,
      h3 {
        font-family: var(--display);
        font-stretch: 112.5%;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin: 0;
      }

      .top,
      main > section,
      .bottom {
        width: min(100% - 32px, 76rem);
        margin-inline: auto;
      }

      .top {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px 24px;
        padding-block: 20px;
      }

      .brand {
        color: var(--accent);
        font-family: var(--display);
        font-stretch: 112.5%;
        font-weight: 800;
        text-decoration: none;
      }

      .top nav {
        display: flex;
        gap: 20px;
      }

      .top nav a {
        color: var(--fg);
        text-decoration: none;
      }

      .top nav a:hover {
        color: var(--accent);
      }

      .hero {
        padding-block: clamp(32px, 6vw, 72px) 24px;
      }

      .hero h1 {
        font-size: clamp(2.25rem, 1.2rem + 3.2vw, 3.4rem);
        line-height: 1.04;
        text-wrap: pretty;
      }

      .hero h1 .accent {
        color: var(--accent);
      }

      .lede {
        max-width: 44rem;
        margin: 24px 0 0;
        font-size: 1.2rem;
        color: var(--muted);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px 28px;
        margin-top: 32px;
      }

      .button {
        display: inline-block;
        padding: 12px 20px;
        border-radius: 6px;
        background: var(--accent);
        color: var(--bg);
        font-weight: 700;
        text-decoration: none;
      }

      .button:hover {
        background: var(--c14);
        text-decoration: underline;
      }

      .for {
        display: none;
      }

      [data-os='macos'] [data-for='macos'],
      [data-os='windows'] [data-for='windows'],
      [data-os='linux'] [data-for='linux'] {
        display: inline;
      }

      .quiet {
        color: var(--fg);
      }

      .note {
        margin: 16px 0 0;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .window {
        position: relative;
        container-type: inline-size;
        margin: 48px 0 0;
        padding: 12px;
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow: hidden;
      }

      .screen {
        --cell: var(--fg);
        margin: 0;
        padding: 0;
        border: 0;
        border-radius: 0;
        overflow: hidden;
        background: var(--bg);
        font-size: calc((100cqi - 1px) / 80);
        line-height: 1.18;
        white-space: pre;
      }

      .screen .d {
        opacity: 0.5;
      }

      .window:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      /* Every screen of the demo sits in the same cell; the one arriving is drawn over the one
         leaving (src/scripts/demo.ts), the splash over both. */
      .stage {
        position: relative;
        display: grid;
      }

      .stage > .screen {
        grid-area: 1 / 1;
      }

      .stage > .arriving {
        z-index: 1;
      }

      .stage > .splash {
        z-index: 2;
      }

      /* The terminal dims everything behind a dialog (Modifier::DIM). */
      .stage.dimmed > .screen {
        opacity: 0.5;
      }

      .dialog {
        position: absolute;
        z-index: 3;
        top: calc(var(--top) * 1.18em);
        left: calc(var(--left) * 1ch);
        width: calc(var(--width) * 1ch);
        height: calc(var(--height) * 1.18em);
        font-family: var(--mono);
        font-size: calc((100cqi - 1px) / 80);
        line-height: 1.18;
      }

      .dialog > .screen {
        position: absolute;
        left: 0;
        width: 100%;
      }

      .dialog > .edge-top {
        top: 0;
      }

      .dialog > .body {
        top: 1.18em;
      }

      .dialog > .edge-bottom {
        top: calc((var(--height) - 1) * 1.18em);
      }

      .try {
        display: none;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin: 14px 0 0;
      }

      [data-os] .try {
        display: flex;
      }

      .try-label {
        margin-right: 6px;
        color: var(--muted);
        font-family: var(--mono);
        font-size: 0.9rem;
      }

      .try button {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 10px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: transparent;
        color: var(--fg);
        font: inherit;
        font-size: 0.9rem;
        cursor: pointer;
      }

      .try button span {
        margin-left: 4px;
      }

      .try button:hover {
        border-color: var(--accent);
      }

      .try button[aria-pressed='true'] {
        border-color: var(--accent);
        color: var(--accent);
      }

      .try button[aria-disabled='true'] {
        opacity: 0.5;
        cursor: default;
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      /* The front of the theme wave, drawn with characters (src/scripts/ascii.ts). */
      .wave {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 20;
        pointer-events: none;
      }

      .screen .b {
        font-weight: 700;
      }

      .screen .r {
        background: var(--cell);
        color: var(--bg);
      }

      /* The shell prompt before the first frame of the screen; shown only while motion is allowed. */
      .boot {
        display: none;
        z-index: 4;
        position: absolute;
        inset: 12px auto auto 12px;
        margin: 0;
        font-family: var(--mono);
        font-size: calc((100cqi - 1px) / 80);
        line-height: 1.18;
        white-space: pre;
      }

      .boot .typed {
        display: inline-block;
        width: 6ch;
        overflow: hidden;
        vertical-align: top;
      }

      .themes {
        display: none;
        margin: 20px 0 0;
        padding: 0;
        border: 0;
      }

      /* data-os is set by the head script, so the picker only shows when it can work. */
      [data-os] .themes {
        display: block;
      }

      .themes legend {
        padding: 0;
        margin-bottom: 12px;
        color: var(--muted);
      }

      .theme-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
        gap: 10px;
      }

      .theme-list button {
        display: grid;
        gap: 4px;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: transparent;
        color: var(--fg);
        font: inherit;
        text-align: left;
        cursor: pointer;
      }

      .theme-list button:hover {
        border-color: var(--accent);
      }

      .theme-list button[aria-pressed='true'] {
        border: 2px solid var(--accent);
        padding: 9px 11px;
      }

      .theme-list button[aria-pressed='true'] .theme-name {
        color: var(--accent);
      }

      .swatch {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        height: 16px;
        margin-bottom: 4px;
        border-radius: 3px;
        overflow: hidden;
      }

      .theme-name {
        font-weight: 700;
      }

      .theme-from {
        color: var(--muted);
        font-size: 0.85rem;
      }

      main > section + section {
        padding-block: clamp(48px, 8vw, 96px) 0;
      }

      h2 {
        font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.1rem);
      }

      .section-lede {
        max-width: 44rem;
        margin: 16px 0 0;
        color: var(--muted);
      }

      .keymap {
        margin: 32px 0 0;
      }

      .key-row {
        display: grid;
        grid-template-columns: minmax(12rem, 16rem) 1fr;
        gap: 8px 32px;
        padding-block: 22px;
        border-top: 1px solid var(--line);
      }

      .key-row dt {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px;
      }

      .combo {
        display: inline-flex;
        align-items: baseline;
        gap: 4px;
      }

      .or {
        margin-right: 4px;
        color: var(--muted);
        font-size: 0.85rem;
      }

      kbd {
        display: inline-block;
        min-width: 1.9em;
        padding: 1px 7px;
        border: 1px solid var(--line);
        border-radius: 5px;
        box-shadow: 0 2px 0 var(--line);
        font-size: 0.85rem;
        text-align: center;
      }

      .key-row dd {
        margin: 0;
      }

      .key-row h3 {
        font-size: 1.05rem;
      }

      .key-row p {
        max-width: 46rem;
        margin: 8px 0 0;
        color: var(--muted);
      }

      .platforms {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-top: 32px;
      }

      .platform {
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-width: 0;
        padding: 20px;
        border: 1px solid var(--line);
        border-radius: 10px;
      }

      .platform p {
        margin: 0;
      }

      .platform .button {
        align-self: flex-start;
        margin-top: auto;
      }

      .platform h3 {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        font-size: 1.3rem;
      }

      .yours {
        display: none;
        font-family: system-ui, sans-serif;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0;
        color: var(--accent);
      }

      [data-os='macos'] [data-platform='macos'],
      [data-os='windows'] [data-platform='windows'],
      [data-os='linux'] [data-platform='linux'] {
        border: 2px solid var(--accent);
        padding: 19px;
      }

      [data-os='macos'] [data-platform='macos'] .yours,
      [data-os='windows'] [data-platform='windows'] .yours,
      [data-os='linux'] [data-platform='linux'] .yours {
        display: inline;
      }

      .file {
        font-family: var(--mono);
        font-size: 0.9rem;
        color: var(--accent);
        overflow-wrap: anywhere;
      }

      .links a {
        margin-right: 0.6em;
      }

      .caveat {
        font-size: 0.92rem;
        color: var(--muted);
      }

      .checksums {
        margin: 20px 0 0;
        color: var(--muted);
        font-size: 0.95rem;
      }

      #source pre {
        margin-top: 24px;
      }

      .bottom {
        position: relative;
        isolation: isolate;
        display: grid;
        justify-items: center;
        gap: 16px;
        padding-block: clamp(64px, 10vw, 120px) 40px;
        text-align: center;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .bottom .logo {
        padding: 0;
        border: 0;
        overflow: visible;
        color: var(--accent);
        font-size: 9px;
        font-weight: 700;
        line-height: 1.2;
      }

      .bottom p {
        margin: 0;
      }

      /* Stars made of characters behind the logo, fading out above the credits. */
      .stars {
        position: absolute;
        inset: 0;
        z-index: -1;
        width: 100%;
        height: 100%;
        pointer-events: none;
        mask-image: linear-gradient(#000 55%, transparent 80%);
      }

      /* Motion (Docs/development/DESIGN.md §2.5): GSAP boots the hero and reveals the page, anime.js
         moves the demo and the theme wave, canvas draws characters. CSS only keeps what waits for
         those scripts (data-motion="wait", set in the head) and the small responses. With reduced
         motion nothing moves or hides. */
      [data-motion='wait'] :is(.hero .word, .lede, .actions, .note, .window, .try, .theme-list button, .reveal, .draw) {
        visibility: hidden;
      }

      @media (prefers-reduced-motion: no-preference) {
        html {
          scroll-behavior: smooth;
        }

        .hero .word {
          display: inline-block;
        }

        .cursor {
          animation: blink 1.06s steps(1) infinite;
        }

        .theme-list button,
        .try button {
          transition:
            color 160ms var(--ease),
            border-color 160ms var(--ease);
        }

        .button {
          transition:
            color 160ms var(--ease),
            background-color 160ms var(--ease),
            transform 160ms var(--ease);
        }

        .button:active {
          transform: translateY(1px);
        }

        kbd {
          transition:
            transform 160ms var(--ease),
            box-shadow 160ms var(--ease),
            border-color 160ms var(--ease),
            color 160ms var(--ease);
        }

        /* A key of a tool pressed as its row arrives (motion.ts). */
        .combo.down kbd {
          transform: translateY(2px);
          box-shadow: 0 0 0 var(--line);
          border-color: var(--accent);
          color: var(--accent);
        }
      }

      @keyframes blink {
        50% {
          opacity: 0;
        }
      }

      @media (max-width: 52rem) {
        .platforms {
          grid-template-columns: 1fr;
        }

        .key-row {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
