---
// One SozoIDE screen as colored text. The runs come from real captures (site/src/data/screens.json,
// made by site/scripts/screens.py): fN is one of the 16 ANSI colors, b bold, d dim and r reverse
// video; text without a class is the terminal foreground. `html` takes rows already built.
interface Props {
  runs?: [string, string][][];
  html?: string;
  name?: string;
  class?: string;
  hidden?: boolean;
  [data: `data-${string}`]: string | number;
}

const { runs = [], html, name, class: className, hidden = false, ...data } = Astro.props;
const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const content =
  html ??
  runs
    .map((row) => row.map(([text, classes]) => (classes ? `<span class="${classes}">${escape(text)}</span>` : escape(text))).join(''))
    .join('\n');
---
<pre class:list={['screen', className]} data-screen={name} hidden={hidden} aria-hidden="true" {...data} set:html={content}></pre>
