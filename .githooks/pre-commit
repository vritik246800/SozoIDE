#!/bin/sh
# Local ruleset: main only changes through pull requests, and Docs/, CLAUDE.md and AGENTS.md stay local.
if [ "$(git symbolic-ref --short HEAD 2>/dev/null)" = main ]; then
    echo "Commits on main are blocked: commit on preview and open a pull request." >&2
    exit 1
fi
if git diff --cached --name-only --diff-filter=ACMR | grep -E '(^Docs/|\.md$)' | grep -vqx README.md; then
    echo "Only README.md may be committed as Markdown: Docs/, CLAUDE.md and AGENTS.md stay local." >&2
    exit 1
fi
